{
  "name": "@mrjacket/smile",
  "version": "1.2.1",
  "description": "Strict API contract validator — lints your spec and verifies real responses against it. Passes clean, or shows you the crime scene.",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    }
  },
  "bin": {
    "smile": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "tsup",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openapi",
    "asyncapi",
    "contract-testing",
    "api-validation",
    "api-linter",
    "spec-validator"
  ],
  "author": {
    "name": "x-name15",
    "url": "https://github.com/x-name15"
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/x-name15/smile.git"
  },
  "homepage": "https://github.com/x-name15/smile#readme",
  "bugs": {
    "url": "https://github.com/x-name15/smile/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "openapi-types": "^12.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.5.0",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@asyncapi/parser": "^1.18.1",
    "@clack/prompts": "^1.7.0",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "graphql": "^17.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
